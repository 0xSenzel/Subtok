{
  "manifest_version": 3,
  "name": "Subtok",
  "version": "0.3.0",
  "description": "Plays your TikTok collections on the Subtok website.",
  "host_permissions": ["https://www.tiktok.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["tiktok.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Open Subtok"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "music-collection-queue@local.invalid",
      "strict_min_version": "109.0"
    }
  }
}
